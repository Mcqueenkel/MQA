# MQA on Linux: environment for deploy/mqa.service (EnvironmentFile=).
# Copy to ~/.config/mqa/mqa.env. See LINUX.md.
#
# Format: KEY=VALUE, one per line. Comments only on their OWN line: systemd keeps anything after
# "=" as the value, so "KEY=1  # note" would set KEY to "1  # note".

# Required off Windows. Exactly 1 = start from the identity file exported on the Windows PC (no
# game, no Frida). Anything else (unset, 0, true, yes) = off. The file must hold device_id,
# device_name, graphics_device_name, ip_address, platform_os_version, screen_h, app_ver and res_ver,
# or MQA refuses to start: an export made before screen_h was added must be redone. Also allows ONE
# mid-run Steam-ticket re-mint on error 394 (never on 391).
UMA_CARRY_IDENTITY=1

# Identity file. Unset = ~/.mqa/auth_config.json (recommended). Absolute or ~/ path: a relative one
# resolves inside ~/mqa and is refused, as is the MQA folder, any OneDrive folder or a \\ path.
#UMA_AUTH_CONFIG=~/.mqa/auth_config.json

# Web UI port, always on 127.0.0.1. Default 1616. If you change it, change mqa_url in
# ~/mqa/uma_runtime/discord_remote.json and your ssh -L to match.
#SWEEPY_PORT=1616

# Scenario lock (mant | unity | ura | grand). Ignored while ExecStart passes --scenario (the flag wins);
# only used if you remove --scenario from the unit.
#SWEEPY_SCENARIO=mant

# Account label for logs and Discord notifications (same as --account NAME).
#SWEEPY_ACCOUNT=main

# Stopgap after a game update when you cannot export again yet (204 = app, 214 = resource version).
# After one successful login the identity file holds the version that worked: remove the line then.
#UMA_APP_VER=
#UMA_RES_VER=

# Not settings: leave UMA_RUNTIME_DIR unset (some state is always under ~/mqa/uma_runtime, so moving
# the rest splits it), and never put your Steam login here (MQA_STEAM_USERNAME, MQA_STEAM_PASSWORD
# and MQA_STEAM_CODE are set internally, only in the Steam-login child process).
